# LLM API Keys
# Copy this file to .env and fill in your actual keys.
# .env is gitignored and must never be committed.
#
# At minimum one of ZHIPUAI_API_KEY / ARK_API_KEY is required
# to run the classification, behavior-chain and detection stages.

# OpenAI
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# ZhipuAI (GLM)
ZHIPUAI_API_KEY=
ZHIPU_BASE_URL=
ZHIPU_MODEL=

# Moonshot (Kimi)
MOONSHOT_API_KEY=

# Qwen (Alibaba)
DASHSCOPE_API_KEY=

# Other
OPENROUTER_API_KEY=

# Volcengine ARK (火山引擎)
ARK_API_KEY=
ARK_BASE_URL=
ARK_MODEL=
